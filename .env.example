SYPRA_LISTEN_ADDR=:8080
SYPRA_DATA_PATH=./data/sypra.json
# SQLite is the default durable state backend. Existing JSON state is imported
# on first startup. Use a PostgreSQL URL only for a centrally managed workspace.
SYPRA_DATABASE_URL=sqlite://./data/sypra.db
# json (default) or text. File logging rotates at the configured byte limit.
SYPRA_LOG_FORMAT=json
SYPRA_LOG_FILE=./data/logs/sypra.log
SYPRA_LOG_MAX_BYTES=10485760
SYPRA_LOG_BACKUPS=5
# Optional OpenTelemetry Collector base URL. Empty keeps telemetry local-only.
# The collector must accept OTLP/HTTP JSON on /v1/traces and /v1/metrics.
SYPRA_OTLP_ENDPOINT=
SYPRA_OTLP_SERVICE_NAME=sypra-ai
# Conservative resource admission defaults for local deployments.
SYPRA_MAX_CONCURRENT_JOBS=1
SYPRA_MAX_ACTIVE_RUNNERS=2
# 0 disables the optional model-weight GPU admission budget.
SYPRA_RUNNER_GPU_BUDGET_MB=0
# Optional default external OpenAI-compatible model endpoint. Leave blank when
# using API-managed native model runners. The mock runner is separate:
# `sypra-mock --listen 127.0.0.1:8082`.
SYPRA_MODEL_ENDPOINT=
SYPRA_MODEL_API_KEY=
# Cloud-model keys are used only by the API process. Never put them in web code.
SYPRA_OPENAI_API_KEY=
SYPRA_XAI_API_KEY=
SYPRA_GEMINI_API_KEY=
# Optional: directory containing config.json, vocab.txt, and model.safetensors.
# Defaults to the all-MiniLM-L6-v2 Hugging Face cache snapshot when present.
SYPRA_EMBEDDING_MODEL_PATH=
# Tool processes are deny-by-default. Configure bare executable names or
# absolute paths that the operator explicitly trusts.
SYPRA_AGENT_TERMINAL_ALLOWLIST=
SYPRA_AGENT_MCP_ALLOWLIST=
SYPRA_AGENT_WORK_DIR=
SYPRA_AGENT_TIMEOUT_SECONDS=30
SYPRA_AGENT_MAX_OUTPUT_BYTES=65536
SYPRA_CORS_ORIGIN=http://localhost:5173
