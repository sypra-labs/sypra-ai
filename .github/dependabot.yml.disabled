# Dependabot is intentionally paused for now.
#
# GitHub only activates Dependabot when this configuration is named exactly
# .github/dependabot.yml. Rename this file back to dependabot.yml to resume
# the update schedule below.
version: 2
updates:
  - package-ecosystem: gomod
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
  - package-ecosystem: npm
    directory: "/web"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
  - package-ecosystem: github-actions
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
